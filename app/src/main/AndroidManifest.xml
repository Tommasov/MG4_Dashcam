<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system"
    android:sharedUserMaxSdkVersion="32">

    <!-- The system shared user above is what lets the native library open /dev/video*.
         It only takes effect if the APK is signed with the head unit's platform key. -->

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Declare camera permission but mark the hardware feature as optional
         to avoid Play Store filtering – this device has physical cameras. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Read by VehicleSpeedReader for the footer speed. -->
    <uses-permission
        android:name="android.car.permission.CAR_VENDOR_EXTENSION"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/drivehub_kamera"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/drivehub_kamera"
        android:supportsRtl="true"
        android:theme="@style/Theme.DrivehubKamera">
        <!-- Automotive system library, present on the head unit. Optional so the app still
             installs where it is not. Used only by VehicleGearProbe, through reflection. -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".dashcam.RecordingService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <receiver
            android:name=".boot.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Yields the camera devices while the factory 360/reverse view is on screen. -->
        <receiver
            android:name=".dashcam.OemAvmReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.saicmotor.hmi.aroundview.startAVMActivity" />
                <action android:name="com.saicmotor.hmi.aroundview.ACTION_START" />
                <action android:name="com.saicmotor.hmi.aroundview.ACTION_STOP" />
            </intent-filter>
        </receiver>

        <!-- External event trigger. Senders must target this fork's package, not upstream's:
             new Intent(ACTION).setPackage("com.tommasov.mg4dashcam"). -->
        <receiver
            android:name=".dashcam.DashcamEventTriggerReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.drivehub.kamera.action.TRIGGER_DASHCAM_EVENT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
