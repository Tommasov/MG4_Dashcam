<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Chromeless DayNight theme, the same base MG4 Simple Launcher uses: AppCompat rather
         than Material3, because the stock controls on this head unit are the older, squarer
         kind and Material You components look like a visitor from another phone. -->
    <style name="Theme.DrivehubKamera" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- One place decides how every dialog in the app looks, including the ones AppCompat
             and the updater put up on their own. -->
        <item name="alertDialogTheme">@style/Theme.DrivehubKamera.Dialog</item>
    </style>

    <style name="Theme.DrivehubKamera.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButton</item>
    </style>
</resources>
