<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Section divider: a label with room above it. -->
    <style name="DashcamSectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/settings_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Caption above a text field. -->
    <style name="DashcamFieldLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/settings_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DashcamField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Switches, checkboxes and radio buttons: one finger-sized row each. -->
    <style name="DashcamChoice" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
