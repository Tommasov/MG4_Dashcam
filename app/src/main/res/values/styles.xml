<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Section divider: a quiet label with room above it, in the accent colour so the eye can
         find the boundaries without a rule across the screen. -->
    <style name="SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/section_gap</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/section_header_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Explanatory line under a control. Two lines at most; if it needs three, the control is
         wrong. -->
    <style name="Hint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/secondary_text_size</item>
    </style>

    <!-- Caption above a text field. -->
    <style name="FieldLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/row_gap</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/secondary_text_size</item>
    </style>

    <style name="Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/field_margin_top</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/field_size</item>
    </style>

    <style name="FieldShort" parent="Field">
        <item name="android:layout_width">@dimen/field_width_short</item>
    </style>

    <!-- Switches, checkboxes and radio buttons. The row carries the height, so the finger has
         88dp to land on whatever the control itself measures. -->
    <style name="Choice" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/row_height</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/row_label_size</item>
    </style>

    <!-- Tonal button: a tint of the text colour rather than a grey of its own, so it belongs to
         whatever background it sits on, by day and by night alike. -->
    <style name="TonalButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/button_gap</item>
        <item name="android:background">@drawable/bg_tonal_button</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:paddingStart">@dimen/button_padding_h</item>
        <item name="android:paddingEnd">@dimen/button_padding_h</item>
        <item name="android:paddingTop">@dimen/button_padding_v</item>
        <item name="android:paddingBottom">@dimen/button_padding_v</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/button_size</item>
    </style>

    <!-- A tonal button that shares a row with others. The row divides its width between them
         instead of letting each one take what its label needs, so no label can push a
         neighbour off the edge of the screen - which is what the Italian labels did to a row
         laid out for the English ones, taking the last button with them and leaving a column
         of wrapped text scrolling below.

         match_parent height keeps a button whose label wraps onto two lines the same height as
         the ones beside it. -->
    <style name="TonalButtonCell" parent="TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- A tonal button over the preview, where the background is black whatever the head unit
         theme says. -->
    <style name="TonalButtonOnDark" parent="TonalButton">
        <item name="android:background">@drawable/bg_tonal_button_on_dark</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Hairline" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/hairline_height</item>
        <item name="android:layout_marginTop">@dimen/row_gap</item>
        <item name="android:background">@color/hairline</item>
    </style>
</resources>
