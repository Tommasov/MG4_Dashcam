    <string name="section_cameras">Cameras</string>
    <string name="section_vehicle">Vehicle</string>
    <string name="dashcam_enabled">Record in a loop</string>
    <string name="dashcam_enabled_summary">Starts with the head unit and keeps a rolling buffer of 30-second clips.</string>
    <string name="storage_target_internal">Internal only</string>
    <string name="storage_target_auto">USB, fall back to internal</string>
