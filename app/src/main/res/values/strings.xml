    <string name="usb_volume_any">whichever is connected</string>
    <string name="usb_volume_title">Which USB memory should the dashcam use?</string>
    <string name="usb_volume_message">Pick one when you keep more than one connected - a stick for the dashcam and another for music, say. With no choice made, the dashcam uses whichever it finds, and refuses to guess when it finds two.</string>
    <string name="usb_volume_entry_any">Whichever is connected</string>
