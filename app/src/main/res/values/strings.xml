    <string name="btn_preview_grid">Preview the recorded frame</string>
    <string name="preview_unavailable">Cannot show it: the cameras are not available. Usually that means the factory 360 view has them, for as long as it is on screen.</string>
    <string name="btn_storage_details">Show storage details</string>
    <string name="btn_send_probe">Send a diagnostics report</string>
    <string name="probe_dialog_title">Send this report to the author?</string>
    <string name="probe_dialog_message">It sends the runtime log, the storage probe with its folder paths, a listing of the factory 360 app folder, the app version and the head unit model. No video, no images, no location. Nothing leaves the car until you confirm.</string>
    <string name="probe_dialog_note_hint">What were you doing? (helps a lot)</string>
    <string name="probe_dialog_send">Send</string>
    <string name="probe_sending">Sending…</string>
    <string name="probe_sent">Sent: %1$s</string>
    <string name="probe_failed">Not sent: %1$s</string>
    <string name="btn_clear_records">Empty the loop recordings</string>
    <string name="clear_records_title">Delete the loop recordings?</string>
    <string name="clear_records_message">Removes the %1$s of 30-second clips in the recording folder. Saved events are not touched: they stay in the events folder, which is the whole point of saving them. This cannot be undone.</string>
    <string name="clear_records_confirm">Delete</string>
    <string name="clear_records_none">Nothing to delete: there are no loop recordings.</string>
    <string name="clear_records_working">Deleting…</string>
    <string name="clear_records_done">Deleted %1$s, freed %2$s</string>
    <string name="storage_usage_checking">Measuring…</string>
    <!-- Counted things need their singular. "1 eventi salvati" is the kind of detail that
         makes an app feel unfinished. -->
    <plurals name="usage_clips">
        <item quantity="one">%d clip</item>
        <item quantity="other">%d clips</item>
    </plurals>
    <plurals name="usage_events">
        <item quantity="one">%d saved event</item>
        <item quantity="other">%d saved events</item>
    </plurals>
    <plurals name="cleared_clips">
        <item quantity="one">%d clip</item>
        <item quantity="other">%d clips</item>
    </plurals>
