<resources>
    <!-- The launcher label and the heading on the screen. Neither needs to say MG4: the app
         only runs on one. Not translated - it is a name. -->
    <string name="app_name">Dashcam</string>

    <!-- Main screen -->
    <string name="section_recording">Recording</string>
    <string name="section_storage">Storage</string>
    <string name="section_cameras">Cameras</string>
    <string name="section_vehicle">Vehicle</string>
    <string name="dashcam_enabled">Record in a loop</string>
    <string name="dashcam_enabled_summary">Starts with the head unit and keeps a rolling buffer of 30-second clips.</string>
    <string name="storage_target_internal">Internal only</string>
    <string name="storage_target_auto">USB, fall back to internal</string>
    <string name="storage_target_usb">USB only</string>
    <string name="label_records_path">Recording folder (leave empty for the default)</string>
    <string name="label_retention_internal">Clips kept on internal storage</string>
    <string name="label_retention_usb">Clips kept on USB</string>
    <string name="label_max_event_dirs">Saved events kept</string>
    <string name="label_fps">Frames per second</string>
    <string name="label_bitrate">Video bitrate (kbit/s)</string>
    <string name="label_bitrate_summary">9000 is the default, and costs about 58 MB a minute. Lower it if the same USB stick also plays music: the dashcam writing hard is what makes the music stutter.</string>
    <string name="label_signature">Footer signature</string>
    <string name="label_show_speed">Show speed in the footer</string>
    <string name="label_oem_coexist">Yield the cameras to the factory 360/reverse view</string>
    <string name="label_oem_max_speed">Yield below this speed (km/h)</string>
    <string name="label_oem_max_speed_summary">Above it the dashcam keeps the cameras and the factory view will not open. The factory app itself stops offering the 360 view at about 15 km/h.</string>
    <string name="label_oem_coexist_summary">With this off, the stock reversing camera cannot open while the dashcam is recording.</string>
    <string name="camera_front">Front</string>
    <string name="camera_rear">Rear</string>
    <string name="camera_left">Left</string>
    <string name="camera_right">Right</string>
    <string name="btn_test_clip">Record a test clip</string>
    <string name="btn_eject_usb">Stop and eject USB</string>
    <string name="section_tools">Tools</string>
    <string name="btn_storage_details">Show storage details</string>
    <string name="btn_send_probe">Send a diagnostics report</string>
    <string name="probe_dialog_title">Send this report to the author?</string>
    <string name="probe_dialog_message">It sends the runtime log, the storage probe with its folder paths, a listing of the factory 360 app folder, the app version and the head unit model. No video, no images, no location. Nothing leaves the car until you confirm.</string>
    <string name="probe_dialog_note_hint">What were you doing? (helps a lot)</string>
    <string name="probe_dialog_send">Send</string>
    <string name="probe_sending">Sending…</string>
    <string name="probe_sent">Sent: %1$s</string>
    <string name="probe_failed">Not sent: %1$s</string>
    <string name="btn_clear_records">Empty the loop recordings</string>
    <string name="clear_records_title">Delete the loop recordings?</string>
    <string name="clear_records_message">Removes the %1$s of 30-second clips in the recording folder. Saved events are not touched: they stay in the events folder, which is the whole point of saving them. This cannot be undone.</string>
    <string name="clear_records_confirm">Delete</string>
    <string name="clear_records_none">Nothing to delete: there are no loop recordings.</string>
    <string name="clear_records_working">Deleting…</string>
    <string name="clear_records_done">Deleted %1$s, freed %2$s</string>
    <string name="storage_usage_checking">Measuring…</string>
    <!-- Counted things need their singular. "1 eventi salvati" is the kind of detail that
         makes an app feel unfinished. -->
    <plurals name="usage_clips">
        <item quantity="one">%d clip</item>
        <item quantity="other">%d clips</item>
    </plurals>
    <plurals name="usage_events">
        <item quantity="one">%d saved event</item>
        <item quantity="other">%d saved events</item>
    </plurals>
    <plurals name="cleared_clips">
        <item quantity="one">%d clip</item>
        <item quantity="other">%d clips</item>
    </plurals>
    <string name="storage_usage">Using %1$s: %2$s, plus %3$s</string>
    <string name="storage_usage_no_events">Using %1$s: %2$s</string>
    <string name="storage_usage_empty">Nothing recorded yet</string>
    <string name="version_line">%1$s (%2$d)</string>
    <string name="storage_details_working">Checking…</string>
    <string name="section_oem">Factory 360 app</string>
    <string name="section_oem_summary">These act on the factory around-view app (com.saicmotor.hmi.aroundview), not on the recordings made by this dashcam. Its hidden test screen leaves raw .nv12 stills and .h264 clips in its own folder and never removes them; both apps run as the same system user, so they can be read and cleared from here.</string>
    <string name="btn_copy_oem_captures">Copy captures out of the 360 app</string>
    <string name="oem_captures_working">Copying…</string>
    <string name="btn_delete_oem_captures">Delete captures inside the 360 app</string>
    <string name="oem_delete_title">Delete files inside the factory 360 app?</string>
    <string name="oem_delete_message">This does not touch your dashcam recordings. It removes the .nv12 stills and .h264 clips left in the private folder of com.saicmotor.hmi.aroundview, the factory around-view app. Anything else in that folder is left alone. This cannot be undone.</string>
    <string name="oem_delete_confirm">Delete</string>
    <string name="oem_deleting">Deleting…</string>

    <string name="usb_volume_button">USB memory: %1$s</string>
    <string name="usb_volume_any">whichever is connected</string>
    <string name="usb_volume_title">Which USB memory should the dashcam use?</string>
    <string name="usb_volume_message">Pick one when you keep more than one connected - a stick for the dashcam and another for music, say. With no choice made, the dashcam uses whichever it finds, and refuses to guess when it finds two.</string>
    <string name="usb_volume_entry_any">Whichever is connected</string>
