<?xml version="1.0" encoding="utf-8"?>
<!-- The same button face, for the one screen with a black field behind it.

     The tonal button takes its colours from the theme, which follows the head unit between day
     and night. Over the preview there is no theme to follow - the background is black at noon as
     much as at midnight - so these are fixed, and light enough to be seen against it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#59FFFFFF" />
            <stroke android:width="1dp" android:color="#8CFFFFFF" />
            <corners android:radius="@dimen/button_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
            <corners android:radius="@dimen/button_radius" />
        </shape>
    </item>
</selector>
