<?xml version="1.0" encoding="utf-8"?>
<!--
    The one button on this screen that is not a setting.

    Everything else in the app is deliberately the head unit's own flat grey, because a dashcam
    should look like part of the car. This is the exception: entering extraction is a thing you
    do on purpose, from the driver's seat, usually in a hurry and often in sunlight, and it has
    to be found without reading. So it carries the accent into a gradient nothing else uses -
    which also means it can never be mistaken for the recording switch above it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/extraction_gradient_start_pressed"
                android:endColor="@color/extraction_gradient_end_pressed" />
            <corners android:radius="@dimen/gradient_button_radius" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_surface" />
            <corners android:radius="@dimen/gradient_button_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/extraction_gradient_start"
                android:endColor="@color/extraction_gradient_end" />
            <corners android:radius="@dimen/gradient_button_radius" />
        </shape>
    </item>
</selector>
