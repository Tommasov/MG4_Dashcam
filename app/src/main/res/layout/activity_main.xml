<?xml version="1.0" encoding="utf-8"?>
<!-- 1920x720 head unit: one scrolling column, generous touch targets, no chrome. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/settings_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="56dp"
            android:text="@string/dashcam_enabled"
            android:textColor="@color/settings_text_primary"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashcam_enabled_summary"
            android:textColor="@color/settings_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/settings_text_highlight"
            android:textSize="16sp" />

        <!-- Storage -->
        <TextView
            style="@style/DashcamSectionHeader"
            android:text="@string/section_storage" />

        <RadioGroup
            android:id="@+id/rgStorageTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbStorageInternal"
                style="@style/DashcamChoice"
                android:text="@string/storage_target_internal" />

            <RadioButton
                android:id="@+id/rbStorageAuto"
                style="@style/DashcamChoice"
                android:text="@string/storage_target_auto" />

            <RadioButton
                android:id="@+id/rbStorageUsb"
                style="@style/DashcamChoice"
                android:text="@string/storage_target_usb" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvStorageStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/settings_text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnEjectUsb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:text="@string/btn_eject_usb" />

        <TextView
            style="@style/DashcamFieldLabel"
            android:text="@string/label_records_path" />

        <EditText
            android:id="@+id/etRecordsPath"
            style="@style/DashcamField"
            android:inputType="textUri"
            android:autofillHints="" />

        <TextView
            style="@style/DashcamFieldLabel"
            android:text="@string/label_retention_internal" />

        <EditText
            android:id="@+id/etRetentionInternal"
            style="@style/DashcamField"
            android:inputType="number"
            android:autofillHints="" />

        <TextView
            style="@style/DashcamFieldLabel"
            android:text="@string/label_retention_usb" />

        <EditText
            android:id="@+id/etRetentionUsb"
            style="@style/DashcamField"
            android:inputType="number"
            android:autofillHints="" />

        <TextView
            style="@style/DashcamFieldLabel"
            android:text="@string/label_max_event_dirs" />

        <EditText
            android:id="@+id/etMaxEventDirs"
            style="@style/DashcamField"
            android:inputType="number"
            android:autofillHints="" />

        <!-- Cameras -->
        <TextView
            style="@style/DashcamSectionHeader"
            android:text="@string/section_cameras" />

        <CheckBox
            android:id="@+id/cbFront"
            style="@style/DashcamChoice"
            android:text="@string/camera_front" />

        <CheckBox
            android:id="@+id/cbRear"
            style="@style/DashcamChoice"
            android:text="@string/camera_rear" />

        <CheckBox
            android:id="@+id/cbLeft"
            style="@style/DashcamChoice"
            android:text="@string/camera_left" />

        <CheckBox
            android:id="@+id/cbRight"
            style="@style/DashcamChoice"
            android:text="@string/camera_right" />

        <!-- Recording -->
        <TextView
            style="@style/DashcamSectionHeader"
            android:text="@string/section_recording" />

        <TextView
            style="@style/DashcamFieldLabel"
            android:text="@string/label_fps" />

        <EditText
            android:id="@+id/etFps"
            style="@style/DashcamField"
            android:inputType="number"
            android:autofillHints="" />

        <TextView
            style="@style/DashcamFieldLabel"
            android:text="@string/label_signature" />

        <EditText
            android:id="@+id/etSignature"
            style="@style/DashcamField"
            android:inputType="text"
            android:autofillHints="" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swShowSpeed"
            style="@style/DashcamChoice"
            android:text="@string/label_show_speed" />

        <!-- Vehicle -->
        <TextView
            style="@style/DashcamSectionHeader"
            android:text="@string/section_vehicle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swOemCoexist"
            style="@style/DashcamChoice"
            android:text="@string/label_oem_coexist" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_oem_coexist_summary"
            android:textColor="@color/settings_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnStorageDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="56dp"
            android:text="@string/btn_storage_details" />

        <TextView
            style="@style/DashcamSectionHeader"
            android:text="@string/section_oem" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_oem_summary"
            android:textColor="@color/settings_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCopyOemCaptures"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:text="@string/btn_copy_oem_captures" />

        <Button
            android:id="@+id/btnDeleteOemCaptures"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:text="@string/btn_delete_oem_captures" />

        <TextView
            android:id="@+id/tvStorageDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/settings_text_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTestClip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:minHeight="56dp"
            android:text="@string/btn_test_clip" />
    </LinearLayout>
</ScrollView>
