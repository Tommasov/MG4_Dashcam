<?xml version="1.0" encoding="utf-8"?>
<!-- 1920x720, read at arm's length. Two columns rather than one: at the head unit's type size
     a single column would run several screens deep while leaving two thirds of the width
     empty. The switch and the status sit above both columns, because they are what someone
     opens this app to see. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- focusableInTouchMode on the container, so the first EditText does not take focus on
         open and bring the keyboard up with it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- An update waiting, said once and at the top.
             It used to be a word beside the version number in the bottom corner, which is
             where somebody looks when they already suspect there is a new version - not where
             they look on opening the screen. Tapping it goes straight to the check. -->
        <TextView
            android:id="@+id/tvUpdateBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/row_gap"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/status_paused"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/status_pill_padding_h"
            android:paddingEnd="@dimen/status_pill_padding_h"
            android:paddingTop="@dimen/status_pill_padding_v"
            android:paddingBottom="@dimen/status_pill_padding_v"
            android:textColor="@color/status_text"
            android:textSize="@dimen/secondary_text_size"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Header: what this is, and what it is doing right now. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <!-- The name and the channel mark travel together, in a box of their own.
                 Sharing the header row put the mark on the row's baseline, which is set by a
                 status pill twice the height of the text, so it hung below the name instead of
                 sitting beside it. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/button_gap"
                    android:text="@string/channel_beta"
                    android:textAllCaps="true"
                    android:textColor="@color/status_paused"
                    android:textSize="@dimen/secondary_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The gap that keeps the status pill against the right edge. It has to be a view
                 of its own: hanging the weight on the title would stretch the title, and
                 hanging it on the channel mark would collapse when that mark is hidden, which
                 is exactly what pulled the pill in beside the name. -->
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStatusDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/button_gap"
                android:gravity="end"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/secondary_text_size" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_status_pill"
                android:minWidth="140dp"
                android:paddingStart="@dimen/status_pill_padding_h"
                android:paddingEnd="@dimen/status_pill_padding_h"
                android:paddingTop="@dimen/status_pill_padding_v"
                android:paddingBottom="@dimen/status_pill_padding_v"
                android:gravity="center"
                android:textSize="@dimen/status_size"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swEnabled"
            style="@style/Choice"
            android:layout_width="wrap_content"
            app:switchPadding="@dimen/switch_padding"
            android:background="@null"
            android:thumb="@drawable/switch_thumb_selector"
            app:track="@drawable/switch_track_selector"
            android:layout_marginTop="@dimen/row_gap"
            android:text="@string/dashcam_enabled" />

        <TextView
            style="@style/Hint"
            android:maxWidth="@dimen/text_measure_max"
            android:text="@string/dashcam_enabled_summary" />

        <!-- Directly under the loop switch, and not in a section further down, because a
             setting nobody finds is a setting nobody has. It belongs next to this one anyway:
             one turns the recording on, the other is how you can tell from the driver's seat
             that it is on. The invitation below shows only while it is off. -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swStatusBarIcon"
            style="@style/Choice"
            android:layout_width="wrap_content"
            app:switchPadding="@dimen/switch_padding"
            android:background="@null"
            android:thumb="@drawable/switch_thumb_selector"
            app:track="@drawable/switch_track_selector"
            android:layout_marginTop="@dimen/row_gap"
            android:text="@string/label_status_bar_icon" />

        <TextView
            android:id="@+id/tvStatusBarIconInvite"
            style="@style/Hint"
            android:maxWidth="@dimen/text_measure_max"
            android:textColor="@color/accent"
            android:text="@string/label_status_bar_icon_invite" />

        <TextView
            android:id="@+id/tvStatusBarIconSummary"
            style="@style/Hint"
            android:maxWidth="@dimen/text_measure_max"
            android:text="@string/label_status_bar_icon_summary" />

        <!-- Folded away, because it spans the whole width of the tablet and sits in the
             middle of a scrolling page: reaching for the page and moving the dot instead is a
             mistake that only happens while driving. The position is already the measured one,
             so almost nobody needs to open this. -->
        <TextView
            android:id="@+id/tvStatusBarIconAdjust"
            style="@style/Hint"
            android:maxWidth="@dimen/text_measure_max"
            android:textColor="@color/accent"
            android:paddingTop="@dimen/row_gap"
            android:paddingBottom="@dimen/row_gap"
            android:text="@string/label_status_bar_icon_adjust" />

        <LinearLayout
            android:id="@+id/grpStatusBarIconX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStatusBarIconX"
                style="@style/Hint"
                android:maxWidth="@dimen/text_measure_max"
                android:text="@string/label_status_bar_icon_position" />

            <SeekBar
                android:id="@+id/sbStatusBarIconX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/row_gap"
                android:paddingBottom="@dimen/row_gap"
                android:thumb="@drawable/seek_thumb"
                android:max="100" />
        </LinearLayout>

        <View style="@style/Hairline" />

        <!-- Two columns -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Left: where the clips go -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/section_storage" />

                <RadioGroup
                    android:id="@+id/rgStorageTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbStorageInternal"
                        style="@style/Choice"
                        android:text="@string/storage_target_internal" />

                    <RadioButton
                        android:id="@+id/rbStorageAuto"
                        style="@style/Choice"
                        android:text="@string/storage_target_auto" />

                    <RadioButton
                        android:id="@+id/rbStorageUsb"
                        style="@style/Choice"
                        android:text="@string/storage_target_usb" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnUsbVolume"
                    style="@style/TonalButton"
                    android:layout_width="match_parent"
                    android:gravity="start|center_vertical"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@+id/tvStorageStatus"
                    style="@style/Hint"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvStorageUsage"
                    style="@style/Hint"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEjectUsb"
                        style="@style/TonalButtonCell"
                        android:layout_marginEnd="@dimen/button_gap"
                        android:text="@string/btn_eject_usb" />

                    <Button
                        android:id="@+id/btnClearRecords"
                        style="@style/TonalButtonCell"
                        android:textColor="@color/warning"
                        android:text="@string/btn_clear_records" />
                </LinearLayout>

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/label_records_path" />

                <EditText
                    android:id="@+id/etRecordsPath"
                    style="@style/Field"
                    android:autofillHints=""
                    android:inputType="textUri" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/label_retention_internal" />

                <EditText
                    android:id="@+id/etRetentionInternal"
                    style="@style/FieldShort"
                    android:autofillHints=""
                    android:inputType="number" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/label_retention_usb" />

                <EditText
                    android:id="@+id/etRetentionUsb"
                    style="@style/FieldShort"
                    android:autofillHints=""
                    android:inputType="number" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/label_max_event_dirs" />

                <EditText
                    android:id="@+id/etMaxEventDirs"
                    style="@style/FieldShort"
                    android:autofillHints=""
                    android:inputType="number" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/column_gap"
                android:layout_height="1dp" />

            <!-- Right: what gets recorded -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/section_cameras" />

                <!-- Two by two: four stacked rows would run half a screen deep for four
                     words, and the width is there. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbFront"
                        style="@style/Choice"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/camera_front" />

                    <CheckBox
                        android:id="@+id/cbRear"
                        style="@style/Choice"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/camera_rear" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbLeft"
                        style="@style/Choice"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/camera_left" />

                    <CheckBox
                        android:id="@+id/cbRight"
                        style="@style/Choice"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/camera_right" />
                </LinearLayout>

                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/section_recording" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/label_fps" />

                <EditText
                    android:id="@+id/etFps"
                    style="@style/FieldShort"
                    android:autofillHints=""
                    android:inputType="number" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/label_bitrate" />

                <EditText
                    android:id="@+id/etBitrate"
                    style="@style/FieldShort"
                    android:autofillHints=""
                    android:inputType="number" />

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="4dp"
                    android:maxWidth="@dimen/text_measure_max"
                    android:text="@string/label_bitrate_summary" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/label_signature" />

                <EditText
                    android:id="@+id/etSignature"
                    style="@style/Field"
                    android:autofillHints=""
                    android:inputType="text" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swShowSpeed"
                    style="@style/Choice"
                    android:layout_width="wrap_content"
                    app:switchPadding="@dimen/switch_padding"
            android:background="@null"
            android:thumb="@drawable/switch_thumb_selector"
            app:track="@drawable/switch_track_selector"
                    android:layout_marginTop="@dimen/row_gap"
                    android:text="@string/label_show_speed" />

                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/section_vehicle" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swOemCoexist"
                    style="@style/Choice"
                    android:layout_width="wrap_content"
                    app:switchPadding="@dimen/switch_padding"
            android:background="@null"
            android:thumb="@drawable/switch_thumb_selector"
            app:track="@drawable/switch_track_selector"
                    android:text="@string/label_oem_coexist" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/label_oem_coexist_summary" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/label_oem_max_speed" />

                <EditText
                    android:id="@+id/etOemMaxSpeed"
                    style="@style/FieldShort"
                    android:autofillHints=""
                    android:inputType="number" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/label_oem_max_speed_summary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swStandbyDiagnostics"
                    style="@style/Choice"
                    android:layout_width="wrap_content"
                    app:switchPadding="@dimen/switch_padding"
                    android:background="@null"
                    android:thumb="@drawable/switch_thumb_selector"
                    app:track="@drawable/switch_track_selector"
                    android:text="@string/label_standby_diagnostics" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/label_standby_diagnostics_summary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swBetaChannel"
                    style="@style/Choice"
                    android:layout_width="wrap_content"
                    app:switchPadding="@dimen/switch_padding"
                    android:background="@null"
                    android:thumb="@drawable/switch_thumb_selector"
                    app:track="@drawable/switch_track_selector"
                    android:text="@string/label_beta_channel" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/label_beta_channel_summary" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Hairline" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_tools" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStorageDetails"
                style="@style/TonalButtonCell"
                android:layout_marginEnd="@dimen/button_gap"
                android:text="@string/btn_storage_details" />

            <Button
                android:id="@+id/btnSendProbe"
                style="@style/TonalButtonCell"
                android:layout_marginEnd="@dimen/button_gap"
                android:text="@string/btn_send_probe" />

            <Button
                android:id="@+id/btnTestClip"
                style="@style/TonalButtonCell"
                android:layout_marginEnd="@dimen/button_gap"
                android:text="@string/btn_test_clip" />

            <Button
                android:id="@+id/btnPreviewGrid"
                style="@style/TonalButtonCell"
                android:text="@string/btn_preview_grid" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCheckUpdates"
            style="@style/TonalButton"
            android:layout_marginTop="@dimen/row_gap"
            android:text="@string/btn_check_updates" />

        <!-- What acts on the factory app, kept apart from what acts on this one: they were
             under the same heading, which read as if these buttons touched the 360 app too. -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_oem" />

        <TextView
            style="@style/Hint"
            android:maxWidth="@dimen/text_measure_max"
            android:text="@string/section_oem_summary" />

        <!-- Two rows rather than one: five labels do not fit across the screen in every
             language, and a horizontal LinearLayout does not wrap - it hands the leftovers a
             width of nothing and lets them fall off the edge. The row above belongs to the
             factory app's folder, the one below to this app. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCopyOemCaptures"
                style="@style/TonalButtonCell"
                android:layout_marginEnd="@dimen/button_gap"
                android:text="@string/btn_copy_oem_captures" />

            <Button
                android:id="@+id/btnDeleteOemCaptures"
                style="@style/TonalButtonCell"
                android:textColor="@color/warning"
                android:text="@string/btn_delete_oem_captures" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStorageDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_gap"
            android:layout_marginBottom="@dimen/screen_padding"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/mono_size"
            android:textIsSelectable="true" />
        <!-- The version line doubles as the update mark: tvUpdateBadge sits beside it and is
             gone unless a check has found something newer. A dot in the corner is as loud as
             this needs to be - nothing here should compete with the recording badge. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_gap"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvUpdateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/row_gap"
                android:textColor="@color/status_paused"
                android:textSize="@dimen/secondary_text_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/secondary_text_size" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
