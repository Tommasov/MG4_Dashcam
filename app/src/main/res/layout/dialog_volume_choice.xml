<?xml version="1.0" encoding="utf-8"?>
<!-- The volume picker's body.

     A dialog cannot show both a message and a single-choice list: AlertDialog keeps one and
     drops the other, silently. The explanation matters here - somebody with one stick has no
     idea why they are being asked - so the two live together in a view of their own instead. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:id="@+id/tvVolumeMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/row_gap"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/secondary_text_size" />

        <RadioGroup
            android:id="@+id/rgVolumes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
